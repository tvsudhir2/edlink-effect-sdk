# Edlink Effect SDK — Environment Configuration
# Copy this file to .env.local and fill in your credentials:
#   cp .env.example .env.local

# ==========================================
# REQUIRED
# ==========================================

# Your Edlink API client secret (used as Bearer token)
# Obtain from https://developer.ed.link
# Automatically redacted in logs via Effect's Secret type
EDLINK_CLIENT_SECRET=your_secret_here

# ==========================================
# OPTIONAL
# ==========================================

# Edlink API base URL (default: https://ed.link/api)
# EDLINK_API_BASE_URL=https://ed.link/api

# Default maximum pages to fetch when no pagination config is specified (default: 3)
# EDLINK_DEFAULT_MAX_PAGES=3
