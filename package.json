{
  "name": "edlink-effect-sdk",
  "version": "1.0.0",
  "description": "Edlink SDK built with Effect-TS — functional, type-safe, stream-based",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "ex-1": "tsx --env-file=.env.local examples/1-fetch-default-pages.ts",
    "ex-3": "tsx --env-file=.env.local examples/3-fetch-max-records.ts",
    "ex-4": "tsx --env-file=.env.local examples/4-process-sequentially.ts"
  },
  "keywords": ["edlink", "effect", "effect-ts", "functional"],
  "author": "Sudheer Tirumalasetty",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@effect/platform": "^0.87.7",
    "@effect/platform-node": "^0.88.11",
    "effect": "^3.19.13"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
